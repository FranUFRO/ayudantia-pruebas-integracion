{
  "name": "ayudantia-pruebas-integracion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ejemplo didactico de pruebas de integracion para reservas de ayudantias.",
  "scripts": {
    "start": "node src/server.js",
    "test": "mocha \"tests/**/*.test.js\" --exit",
    "test:unit": "mocha \"tests/unit/**/*.test.js\" --exit",
    "test:integration": "mocha \"tests/integration/**/*.test.js\" --exit",
    "test:integration:bottom-up": "mocha \"tests/integration/reservationRepository.test.js\" --exit",
    "test:integration:top-down": "mocha \"tests/integration/reservationsApi.test.js\" --exit",
    "test:integration:sandwich": "mocha \"tests/integration/reservationConsistency.test.js\" --exit",
    "test:integration:big-bang": "mocha \"tests/integration/reservationFlow.test.js\" --exit",
    "test:demo-bug": "mocha \"tests/integration/demoBug.test.js\" --exit"
  },
  "dependencies": {
    "express": "4.21.2",
    "sqlite3": "5.1.7"
  },
  "devDependencies": {
    "chai": "5.1.2",
    "mocha": "10.8.2",
    "supertest": "7.0.0"
  }
}
